# GENERATED by theme/apply.py — {{ name_title }}
# vicinae's theme format is TOML (introduced in v0.15.0; the JSON format it
# replaced is no longer read). Theme id = this filename without ".toml".

[meta]
version = 1
name = "{{ name_title }}"
description = "Generated from theme/palettes/{{ name }}.toml"
variant = "dark"
inherits = "vicinae-dark"

[colors.core]
accent = "{{ color.magenta }}"
accent_foreground = "{{ color.base }}"
background = "{{ color.base }}"
foreground = "{{ color.text }}"
secondary_background = "{{ color.mantle }}"
border = "{{ color.violet_deco }}"

[colors.main_window]
border = "{{ color.violet_deco }}"
footer = { background = "colors.core.secondary_background" }

[colors.settings_window]
border = "{{ color.violet_deco }}"

[colors.accents]
blue = "{{ color.blue }}"
green = "{{ color.green }}"
magenta = "{{ color.magenta }}"
orange = "{{ color.peach }}"
red = "{{ color.red }}"
yellow = "{{ color.yellow }}"
cyan = "{{ color.cyan }}"
purple = "{{ color.violet }}"

[colors.shortcut]
border = "colors.core.border"

[colors.text]
default = "colors.core.foreground"
muted = "{{ color.muted }}"
danger = "{{ color.red }}"
success = "{{ color.green }}"
placeholder = "{{ color.subtext }}"
selection = { background = "{{ color.magenta }}", foreground = "{{ color.base }}" }

[colors.text.links]
default = "{{ color.peach }}"
visited = "{{ color.violet }}"

[colors.input]
border = "{{ color.violet_deco }}"
border_focus = "{{ color.magenta }}"
border_error = "{{ color.red }}"

[colors.button.primary]
background = "{{ color.surface0 }}"
foreground = "{{ color.text }}"
hover = { background = "{{ color.surface1 }}" }
focus = { outline = "colors.core.accent" }

[colors.list.item.hover]
foreground = "{{ color.text }}"
secondary_foreground = "{{ color.text }}"

[colors.list.item.selection]
background = "{{ color.surface1 }}"
foreground = "{{ color.text }}"
secondary_background = "{{ color.surface1 }}"
secondary_foreground = "{{ color.text }}"

[colors.grid.item]
background = "{{ color.surface0 }}"
hover = { outline = "{{ color.text }}" }
selection = { outline = "{{ color.magenta }}" }

[colors.scrollbars]
background = "{{ color.surface1 }}"

[colors.loading]
bar = "{{ color.magenta }}"
spinner = "{{ color.text }}"
