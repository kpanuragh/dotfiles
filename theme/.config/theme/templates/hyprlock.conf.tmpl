# GENERATED by theme/apply.py — {{ name_title }}
$base     = rgb({{ color.base_bare }})
$mantle   = rgb({{ color.mantle_bare }})
$surface  = rgb({{ color.surface0_bare }})
$text     = rgb({{ color.text_bare }})
$accent   = rgb({{ color.magenta_bare }})
$accent2  = rgb({{ color.peach_bare }})
$subtext  = rgb({{ color.subtext_bare }})
$red      = rgb({{ color.red_bare }})

general {
    hide_cursor = true
    # grace, no_fade_in, disable_loading_bar were removed in hyprlock 0.9.x.
    # grace is a CLI flag: launched as `hyprlock --grace 2` from hypridle.conf.
}

background {
    monitor =
    path    = ~/Pictures/Wallpapers/current
    blur_passes = 3
    blur_size   = 8
    contrast    = 0.9
    brightness  = 0.7
    vibrancy    = 0.24
}

# Clock
label {
    monitor =
    text = cmd[update:1000] echo "$(date +'%H:%M')"
    color = $text
    font_size = 96
    font_family = {{ font.family }} Bold
    position = 0, 200
    halign = center
    valign = center
}

# Date
label {
    monitor =
    text = cmd[update:60000] echo "$(date +'%A, %B %d')"
    color = $subtext
    font_size = 22
    font_family = {{ font.family }}
    position = 0, 110
    halign = center
    valign = center
}

# User
label {
    monitor =
    text = $USER
    color = $accent
    font_size = 18
    font_family = {{ font.family }}
    position = 0, -100
    halign = center
    valign = center
}

# Password input
input-field {
    monitor =
    size = 320, 56
    outline_thickness = {{ geometry.border_size }}
    dots_size         = 0.25
    dots_spacing      = 0.4
    outer_color       = $accent
    inner_color       = rgba({{ color.surface0_bare }}aa)
    font_color        = $text
    fade_on_empty     = true
    placeholder_text  = <i>Password…</i>
    hide_input        = false
    rounding          = {{ geometry.rounding }}
    check_color       = $accent2
    fail_color        = $red
    fail_text         = <b>Wrong</b>
    position          = 0, -160
    halign            = center
    valign            = center
}
