# GENERATED by theme/apply.py — {{ name_title }}
# Replaces the catppuccin tmux plugin: colours AND window-status format.

set -g status-style "bg={{ color.base }},fg={{ color.text }}"
set -g status-justify left
set -g status-left-length 40
set -g status-right-length 80

# Session name, magenta pill
set -g status-left "#[bg={{ color.magenta }},fg={{ color.base }},bold]  #S #[default] "

# Host + clock
set -g status-right "#[fg={{ color.muted }}]#h #[fg={{ color.surface2 }}]│ #[fg={{ color.peach }}]%H:%M #[fg={{ color.muted }}]%d %b"

# Windows — flat highlight block (window name, then number), NOT the catppuccin
# plugin's rounded powerline capsules. Those separator glyphs are not
# reproduced here; this replacement is a plain coloured block.
set -g window-status-format "#[fg={{ color.muted }}] #W #[fg={{ color.surface2 }}]#I "
set -g window-status-current-format "#[bg={{ color.surface1 }},fg={{ color.peach }},bold] #W #[fg={{ color.magenta }}]#I "
set -g window-status-separator ""

# Panes
set -g pane-border-style "fg={{ color.surface2 }}"
set -g pane-active-border-style "fg={{ color.magenta }}"

# Messages and command prompt
set -g message-style "bg={{ color.surface1 }},fg={{ color.text }}"
set -g message-command-style "bg={{ color.surface1 }},fg={{ color.text }}"

# Copy mode
set -g mode-style "bg={{ color.magenta }},fg={{ color.base }}"

# Activity
set -g window-status-activity-style "fg={{ color.yellow }}"
set -g window-status-bell-style "fg={{ color.red }},bold"
