### Sway + Catppuccin Mocha
set $mod      Mod4
set $term     kitty
set $browser  brave-browser-stable
set $editor   nvim
set $menu     wofi --show drun -i
set $power    ~/.config/sway/scripts/power-menu.sh

font pango:JetBrains Mono 10

# === Catppuccin Mocha palette ===
set $base      #1e1e2e
set $mantle    #181825
set $crust     #11111b
set $surface0  #313244
set $surface1  #45475a
set $surface2  #585b70
set $overlay0  #6c7086
set $text      #cdd6f4
set $subtext0  #a6adc8
set $rosewater #f5e0dc
set $flamingo  #f2cdcd
set $pink      #f5c2e7
set $mauve     #cba6f7
set $red       #f38ba8
set $maroon    #eba0ac
set $peach     #fab387
set $yellow    #f9e2af
set $green     #a6e3a1
set $teal      #94e2d5
set $sky       #89dceb
set $sapphire  #74c7ec
set $blue      #89b4fa
set $lavender  #b4befe

# Window borders + colors                border    bg     text   indicator child_border
client.focused                          $mauve    $base  $text  $mauve    $mauve
client.focused_inactive                 $surface1 $base  $text  $surface1 $surface1
client.unfocused                        $surface0 $base  $text  $surface0 $surface0
client.urgent                           $red      $base  $text  $red      $red
client.placeholder                      $base     $base  $text  $base     $base
client.background                       $base

default_border         pixel 2
default_floating_border pixel 2
gaps inner 8
gaps outer 4
smart_gaps on
smart_borders on
hide_edge_borders smart
title_align center
focus_follows_mouse yes
mouse_warping container
focus_wrapping no
workspace_auto_back_and_forth yes

# === Inputs ===
input "type:keyboard" {
    xkb_layout us
    repeat_delay 250
    repeat_rate 40
}
input "type:touchpad" {
    tap enabled
    natural_scroll enabled
    middle_emulation enabled
    dwt enabled
    accel_profile adaptive
    pointer_accel 0.3
    scroll_method two_finger
    click_method clickfinger
    tap_button_map lrm
}

# === Output ===
# Wallpaper — fill mode covers the screen; falls back to solid Mocha base if file is missing
output * bg ~/Pictures/Wallpapers/current fill #1e1e2e
# Per-monitor overrides go here once you know the names; check with `swaymsg -t get_outputs`.
# Example: output eDP-1 scale 1.0 mode 1920x1200@60Hz position 0 0

# === Cursor ===
seat seat0 xcursor_theme Adwaita 24

# === Workspace named icons (Symbols Nerd Font glyphs) ===
set $ws1  "1: "
set $ws2  "2: "
set $ws3  "3: "
set $ws4  "4: "
set $ws5  "5: "
set $ws6  "6: "
set $ws7  "7: "
set $ws8  "8: "
set $ws9  "9: "
set $ws10 "10:"

# === Keybindings ===
# Apps
bindsym $mod+Return     exec $term
bindsym $mod+Shift+b    exec $browser
bindsym $mod+Shift+f    exec $term ranger
bindsym $mod+Shift+e    exec $term $editor
bindsym $mod+Shift+p    exec kitty --class "tui-mixer" -e pulsemixer
bindsym $mod+Shift+g    exec kitty --class "tui-git" -e tig
bindsym $mod+Shift+m    exec kitty --class "tui-mail" -e neomutt
bindsym $mod+d          exec $menu
bindsym $mod+x          exec $power
bindsym $mod+Shift+w    exec ~/.config/sway/scripts/wallpaper-switcher.sh
bindsym $mod+Shift+v    exec cliphist list | wofi --dmenu --prompt "Clipboard" | cliphist decode | wl-copy
bindsym $mod+q          kill
bindsym $mod+Shift+c    reload
bindsym $mod+Shift+q    exec swaymsg exit

# Focus
bindsym $mod+h focus left
bindsym $mod+j focus down
bindsym $mod+k focus up
bindsym $mod+l focus right
bindsym $mod+Left  focus left
bindsym $mod+Down  focus down
bindsym $mod+Up    focus up
bindsym $mod+Right focus right
bindsym $mod+Tab        workspace back_and_forth

# Move
bindsym $mod+Shift+h move left
bindsym $mod+Shift+j move down
bindsym $mod+Shift+k move up
bindsym $mod+Shift+l move right
bindsym $mod+Shift+Left  move left
bindsym $mod+Shift+Down  move down
bindsym $mod+Shift+Up    move up
bindsym $mod+Shift+Right move right

# Workspaces (named)
bindsym $mod+1 workspace $ws1
bindsym $mod+2 workspace $ws2
bindsym $mod+3 workspace $ws3
bindsym $mod+4 workspace $ws4
bindsym $mod+5 workspace $ws5
bindsym $mod+6 workspace $ws6
bindsym $mod+7 workspace $ws7
bindsym $mod+8 workspace $ws8
bindsym $mod+9 workspace $ws9
bindsym $mod+0 workspace $ws10
bindsym $mod+Shift+1 move container to workspace $ws1
bindsym $mod+Shift+2 move container to workspace $ws2
bindsym $mod+Shift+3 move container to workspace $ws3
bindsym $mod+Shift+4 move container to workspace $ws4
bindsym $mod+Shift+5 move container to workspace $ws5
bindsym $mod+Shift+6 move container to workspace $ws6
bindsym $mod+Shift+7 move container to workspace $ws7
bindsym $mod+Shift+8 move container to workspace $ws8
bindsym $mod+Shift+9 move container to workspace $ws9
bindsym $mod+Shift+0 move container to workspace $ws10
bindsym $mod+Ctrl+h    workspace prev
bindsym $mod+Ctrl+l    workspace next

# Layout
bindsym $mod+v          splith
bindsym $mod+s          splitv
bindsym $mod+t          layout tabbed
bindsym $mod+w          layout toggle split
bindsym $mod+f          fullscreen toggle
bindsym $mod+Shift+space floating toggle
bindsym $mod+space      focus mode_toggle
bindsym $mod+a          focus parent
bindsym $mod+Shift+a    focus child

# Scratchpad
bindsym $mod+Shift+minus move scratchpad
bindsym $mod+minus       scratchpad show

# Resize
mode "resize" {
    bindsym h resize shrink width  20px
    bindsym j resize grow   height 20px
    bindsym k resize shrink height 20px
    bindsym l resize grow   width  20px
    bindsym Left  resize shrink width  20px
    bindsym Down  resize grow   height 20px
    bindsym Up    resize shrink height 20px
    bindsym Right resize grow   width  20px
    bindsym Return mode "default"
    bindsym Escape mode "default"
}
bindsym $mod+r mode "resize"

# Screenshots
bindsym Print            exec grim -g "$(slurp)" - | wl-copy && notify-send "Screenshot" "Region copied to clipboard"
bindsym Shift+Print      exec grim - | wl-copy && notify-send "Screenshot" "Full screen copied to clipboard"
bindsym $mod+Print       exec sh -c 'mkdir -p ~/Pictures/Screenshots && f=~/Pictures/Screenshots/screenshot-$(date +%Y%m%d-%H%M%S).png && grim -g "$(slurp)" "$f" && notify-send "Screenshot saved" "$f"'
bindsym $mod+Shift+Print exec sh -c 'mkdir -p ~/Pictures/Screenshots && f=~/Pictures/Screenshots/screenshot-$(date +%Y%m%d-%H%M%S).png && grim "$f" && notify-send "Screenshot saved" "$f"'

# Audio (PipeWire / wpctl)
bindsym XF86AudioRaiseVolume exec wpctl set-volume -l 1.5 @DEFAULT_AUDIO_SINK@ 5%+
bindsym XF86AudioLowerVolume exec wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%-
bindsym XF86AudioMute        exec wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle
bindsym XF86AudioMicMute     exec wpctl set-mute @DEFAULT_AUDIO_SOURCE@ toggle
bindsym XF86AudioPlay        exec playerctl play-pause
bindsym XF86AudioNext        exec playerctl next
bindsym XF86AudioPrev        exec playerctl previous

# Brightness (intel_backlight is writable to 'video' group via udev — anuragh is already in video)
bindsym XF86MonBrightnessUp   exec sh -c 'cur=$(cat /sys/class/backlight/intel_backlight/brightness); max=$(cat /sys/class/backlight/intel_backlight/max_brightness); new=$((cur + max/20)); [ $new -gt $max ] && new=$max; echo $new > /sys/class/backlight/intel_backlight/brightness'
bindsym XF86MonBrightnessDown exec sh -c 'cur=$(cat /sys/class/backlight/intel_backlight/brightness); max=$(cat /sys/class/backlight/intel_backlight/max_brightness); new=$((cur - max/20)); [ $new -lt 1 ] && new=1; echo $new > /sys/class/backlight/intel_backlight/brightness'

# Lock
bindsym $mod+Shift+x exec swaylock

# Notifications (mako)
bindsym $mod+grave       exec makoctl dismiss
bindsym $mod+Shift+grave exec makoctl restore
bindsym $mod+Ctrl+grave  exec makoctl dismiss --all

# === Floating rules ===
for_window [app_id="tui-mixer"]                floating enable, resize set 800 600
for_window [app_id="tui-git"]                  floating enable, resize set 1200 800
for_window [app_id="nm-connection-editor"]     floating enable, resize set 700 500
for_window [app_id="blueman-manager"]          floating enable, resize set 700 500
for_window [app_id="org.kde.kcalc"]            floating enable, resize set 350 500
for_window [app_id="org.gnome.Calculator"]     floating enable, resize set 350 500
for_window [title="^Picture-in-Picture$"]      floating enable, sticky enable, resize set 480 270, move position 1380 700
for_window [title="^Picture in picture$"]      floating enable, sticky enable, resize set 480 270, move position 1380 700
for_window [window_role="pop-up"]              floating enable
for_window [window_role="bubble"]              floating enable
for_window [window_role="task_dialog"]         floating enable
for_window [window_role="Preferences"]         floating enable
for_window [window_type="dialog"]              floating enable
for_window [window_type="menu"]                floating enable
for_window [class="^Steam$"][title="^Friends$"] floating enable
for_window [title="File Operation Progress"]   floating enable, resize set 600 200
for_window [title="^Open File"]                floating enable, resize set 800 600
for_window [title="^Save File"]                floating enable, resize set 800 600

# === Idle inhibit (don't sleep while watching/calling) ===
for_window [app_id="brave-browser"] inhibit_idle fullscreen
for_window [app_id="mpv"]           inhibit_idle visible
for_window [app_id="vlc"]           inhibit_idle visible
for_window [app_id="zoom"]          inhibit_idle visible
for_window [class="zoom"]           inhibit_idle visible

# === Workspace assignments ===
assign [app_id="brave-browser"] workspace $ws2
assign [app_id="code"]          workspace $ws3
assign [app_id="code-oss"]      workspace $ws3
assign [class="Code"]           workspace $ws3
assign [app_id="tui-mail"]      workspace $ws5
assign [class="Steam"]          workspace $ws9

# === XWayland tag ===
for_window [shell="xwayland"] title_format "%title [X]"

# === Autostart ===
exec dbus-update-activation-environment --systemd WAYLAND_DISPLAY XDG_CURRENT_DESKTOP=sway DISPLAY
exec --no-startup-id mako
exec --no-startup-id waybar
exec --no-startup-id /usr/libexec/polkit-gnome-authentication-agent-1
exec --no-startup-id blueman-applet
exec --no-startup-id wl-paste --type text  --watch cliphist store 2>/dev/null
exec --no-startup-id wl-paste --type image --watch cliphist store 2>/dev/null
exec --no-startup-id swayidle -w \
        timeout 300 'swaylock -f' \
        timeout 600 'swaymsg "output * dpms off"' \
             resume 'swaymsg "output * dpms on"' \
        before-sleep 'swaylock -f' \
        lock 'swaylock -f'

# Optional: include drop-ins from ~/.config/sway/config.d/
include ~/.config/sway/config.d/*
